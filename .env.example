# Copy to .env and replace every required value before starting the stack.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=life_db
MYSQL_USER=lifetree_user
MYSQL_PASSWORD=
MYSQL_PORT=3306

JWT_SECRET=
CRON_SECRET_TOKEN=
AI_API_KEY=
TREE_SNAPSHOT_TOKEN=
SNAPSHOT_STORAGE_DIR=

# Only needed when intentionally replacing local data with prisma:seed.
ALLOW_DESTRUCTIVE_SEED=false
SEED_USER_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=

NEXT_PUBLIC_BASE_URL=http://localhost:3000
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
